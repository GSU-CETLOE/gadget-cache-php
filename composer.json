{
    "name": "gsu-cetloe/gadget-cache-php",
    "description": "Gadget library for working with cache",
    "type": "library",
    "keywords": [],
    "homepage": "https://github.com/GSU-CETLOE/gadget-cache-php",
    "license": "MIT",
    "authors": [
      {
        "name": "Jeb Barger",
        "role": "Application Developer"
      }
    ],
    "require": {
      "php": "8.1.*",
      "ext-json": "*",
      "gsu-cetloe/gadget-core-php": "^1.0",
      "gsu-cetloe/symfony-bundle": "^1.0",
      "psr/cache": "^3.0"
    },
    "require-dev": {
      "phpstan/phpstan": "^2.0",
      "phpstan/phpstan-strict-rules": "^2.0",
      "phpstan/extension-installer": "^1.4",
      "phpunit/phpunit": "^10.5",
      "squizlabs/php_codesniffer": "^3.10",
      "symfony/cache": "6.4.*"
    },
    "autoload": {
      "psr-4": {
        "Gadget\\Cache\\": ["src/", "bundle/"]
      }
    },
    "autoload-dev": {
      "psr-4": {
        "Gadget\\Cache\\Tests\\": "tests/"
      }
    },
    "config": {
      "allow-plugins": {
        "phpstan/extension-installer": true
      },
      "platform": {
        "php": "8.1.0"
      },
      "sort-packages": true,
      "optimize-autoloader": true,
      "apcu-autoloader": true
    },
    "scripts": {
      "phpcs": "vendor/bin/phpcs",
      "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon",
      "test": "vendor/bin/phpunit",
      "check": [
        "@phpcs",
        "@phpstan",
        "@test"
      ]
    }
  }
